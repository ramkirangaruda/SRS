# Dependencies — reinstalled from package.json, never committed.
/node_modules

# Next.js build output.
/.next/
/out/

# Production build.
/build

# Environment files hold secrets (auth keys) — keep them out of git.
.env
.env*.local

# Prisma SQLite database files — local data, not source code.
/prisma/*.db
/prisma/*.db-journal

# PWA service worker files are generated by next-pwa at build time.
/public/sw.js
/public/workbox-*.js
/public/worker-*.js
/public/sw.js.map
/public/workbox-*.js.map

# User-uploaded files (student photos) — runtime data, not source.
/public/uploads

# OS / editor noise.
.DS_Store
*.log
