{
  "name": "schoolsync",
  "version": "0.1.0",
  "private": true,
  "comment": "Scripts are the commands you'll run while developing. 'dev' runs the hot-reloading dev server; 'db:push' syncs the Prisma schema to SQLite; 'db:seed' loads our demo users.",
  "scripts": {
    "predev": "node scripts/free-port.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "comment": "Tells Prisma how to run our TypeScript seed file (via tsx, a zero-config TS runner).",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
