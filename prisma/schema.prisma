// ============================================================================
// SchoolSync database schema — the single source of truth for every table.
//
// SQLite limitations we design around (all handled with String):
//   1. No native enums      -> status/role/type fields are String. Allowed values
//                              are documented in a comment next to each field.
//   2. No Json column type   -> JSON data (timetable periods, meal menus) is
//                              stored as a stringified JSON String.
//   3. No scalar lists       -> "attachments" (many files) is a JSON String array.
//
// Conventions:
//   - Every model has id (cuid), createdAt, updatedAt.
//   - Foreign keys end in "Id" and carry an @@index (we query by them constantly).
//   - Frequently filtered fields (date, status, admissionNumber) are also indexed.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// CORE
// ----------------------------------------------------------------------------

// The tenant root. Almost every other record carries a schoolId pointing here,
// which is what makes the app "multi-school" ready: data is partitioned per school.
model School {
  id                        String  @id @default(cuid())
  name                      String
  address                   String?
  logo                      String?
  phone                     String?
  email                     String?
  activeAcademicYear        String? // Convenience label, e.g. "2025-2026".
  showRankToParents         Boolean @default(false) // whether parents see class rank
  showStaffContactToParents Boolean @default(false) // parents see staff phone/email
  // Profile (settings → school profile).
  website                   String?
  establishedYear           String?
  board                     String? // CBSE | ICSE | STATE | IB | OTHER
  schoolCode                String? // UDISE / school code
  // Invite code parents enter at signup to join this school (settings → share).
  inviteCode                String? @unique
  // Editable legal content (settings → privacy/terms). Plain text/markdown.
  privacyPolicy             String?
  termsOfService            String?

  // Back-relations: one School has many of nearly everything. These let us write
  // queries like `prisma.school.findFirst({ include: { students: true } })`.
  users                   User[]
  students                Student[]
  classes                 Class[]
  academicYears           AcademicYear[]
  admissionQueries        AdmissionQuery[]
  enquiries               Enquiry[]
  enquiryCategories       EnquiryCategory[]
  broadcastMessages       BroadcastMessage[]
  feedbacks               Feedback[]
  schoolDiaries           SchoolDiary[]
  feeStructures           FeeStructure[]
  feePayments             FeePayment[]
  homeworks               Homework[]
  subjects                Subject[]
  curriculums             Curriculum[]
  timetables              Timetable[]
  testReports             TestReport[]
  progressReports         ProgressReport[]
  eLearningCategories     ELearningCategory[]
  tutorials               Tutorial[]
  assignments             Assignment[]
  events                  Event[]
  holidays                Holiday[]
  mealCalendars           MealCalendar[]
  meetingGroups           MeetingGroup[]
  daycareLogs             DaycareLog[]
  galleryAlbums           GalleryAlbum[]
  videos                  Video[]
  staffMembers            StaffMember[]
  virtualClassrooms       VirtualClassroom[]
  visitorRegisters        VisitorRegister[]
  planners                Planner[]
  resources               Resource[]
  periodTemplates         PeriodTemplate[]
  timetableEntries        TimetableEntry[]
  notificationPreferences NotificationPreference[]
  bugReports              BugReport[]
  supportMessages         SupportMessage[]
  activityLogs            ActivityLog[]
  notifications           Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Anyone who can log in. role is "PRINCIPAL" | "TEACHER" | "PARENT" (validated in
// lib/roles.ts). We store passwordHash (bcrypt), never plaintext.
model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String // bcrypt hash. Named per spec; treat as the hash.
  phone             String?
  role              String    @default("PARENT")
  avatar            String?
  // Soft on/off switch. Deactivating a teacher (e.g. resigned) flips this to
  // false so they can't log in, WITHOUT deleting the user — preserving all the
  // historical rows (timetable, homework, virtual classes) that reference them.
  isActive          Boolean   @default(true)
  // i18n preference (settings → language). UI locale, e.g. "en" | "hi".
  locale            String    @default("en")
  // Session-invalidation marker: any JWT issued before this instant is rejected
  // (see lib/auth.ts). Updating it on password change logs out other devices.
  passwordChangedAt DateTime?
  lastLoginAt       DateTime? // for the "active users" share stats

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  // A PARENT links to their children (1:N). Single relation -> no relation name.
  children Student[]

  // Every place a User can act gets its own back-relation. Where a model touches
  // User more than once (Feedback) we MUST name the relations to disambiguate.
  attendancesMarked       Attendance[]
  broadcastMessages       BroadcastMessage[]
  broadcastReceipts       BroadcastRecipient[]
  diaryReads              DiaryRead[]
  feedbacksGiven          Feedback[]               @relation("FeedbackParent")
  feedbacksReplied        Feedback[]               @relation("FeedbackRepliedBy")
  feedbackMessages        FeedbackMessage[]
  schoolDiaries           SchoolDiary[]
  feePaymentsCollected    FeePayment[]
  homeworksAssigned       Homework[]
  tutorialsUploaded       Tutorial[]
  assignmentsUploaded     Assignment[]
  videosUploaded          Video[]
  meetingGroupsCreated    MeetingGroup[]
  meetingGroupMemberships MeetingGroupMember[]
  meetingMessages         MeetingMessage[]
  daycareLogsRecorded     DaycareLog[]
  staffMember             StaffMember? // 1:1
  virtualClassroomsHosted VirtualClassroom[]
  plannersCreated         Planner[]
  resourcesUploaded       Resource[]
  timetableEntries        TimetableEntry[]         @relation("TeacherTimetable")
  visitorsHosted          VisitorRegister[]        @relation("VisitorHost")
  enquiryActivities       EnquiryActivity[]
  admissionActivities     AdmissionActivity[]
  admissionsProcessed     AdmissionQuery[]         @relation("AdmissionProcessor")
  notificationPreferences NotificationPreference[]
  bugReports              BugReport[]
  supportMessages         SupportMessage[]
  activityLogs            ActivityLog[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  paymentTransactions     PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([role])
}

// A pupil. admissionNumber is unique (front-desk lookup key). classId required;
// sectionId/parentId optional so a student can exist before full assignment.
model Student {
  id              String    @id @default(cuid())
  name            String
  admissionNumber String    @unique
  dateOfBirth     DateTime?
  gender          String? // "MALE" | "FEMALE" | "OTHER"
  bloodGroup      String?
  address         String?
  photo           String?
  isDaycare       Boolean   @default(false) // enrolled in daycare (shows daycare menu)

  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])
  parentId  String?
  parent    User?    @relation(fields: [parentId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  // Everything that accumulates per student over time.
  attendances           Attendance[]
  feePayments           FeePayment[]
  paymentTransactions   PaymentTransaction[]
  testReports           TestReport[]
  progressReports       ProgressReport[]
  assignmentSubmissions AssignmentSubmission[]
  daycareLogs           DaycareLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([parentId])
}

// A grade level, e.g. "1st". Holds sections, students, subjects, fees, etc.
model Class {
  id       String @id @default(cuid())
  name     String
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  sections           Section[]
  students           Student[]
  subjects           Subject[]
  feeStructures      FeeStructure[]
  homeworks          Homework[]
  curriculums        Curriculum[]
  timetables         Timetable[]
  schoolDiaries      SchoolDiary[]
  tutorials          Tutorial[]
  assignments        Assignment[]
  virtualClassrooms  VirtualClassroom[]
  planners           Planner[]
  timetableEntries   TimetableEntry[]
  admissionsAssigned AdmissionQuery[]   @relation("AdmissionAssignedClass")
  broadcastMessages  BroadcastMessage[] // BroadcastMessage.targetClassId (nullable)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// A division within a class, e.g. "A". Deleting a class cascades its sections.
model Section {
  id      String @id @default(cuid())
  name    String
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  students           Student[]
  homeworks          Homework[]
  timetables         Timetable[]
  schoolDiaries      SchoolDiary[]
  assignments        Assignment[]
  timetableEntries   TimetableEntry[]
  virtualClassrooms  VirtualClassroom[]
  admissionsAssigned AdmissionQuery[]   @relation("AdmissionAssignedSection")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

// An academic year, e.g. "2025-2026". isActive flags the current one.
model AcademicYear {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  feeStructures    FeeStructure[]
  progressReports  ProgressReport[]
  timetableEntries TimetableEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([isActive])
}

// ----------------------------------------------------------------------------
// ADMISSION & ENQUIRY
// ----------------------------------------------------------------------------

// A formal admission application. status: PENDING | APPROVED | REJECTED.
model AdmissionQuery {
  id                      String              @id @default(cuid())
  studentName             String
  dateOfBirth             DateTime?
  gender                  String?
  bloodGroup              String?
  previousSchool          String?
  classAppliedFor         String
  // Parent info.
  parentName              String // father name (kept for back-compat)
  motherName              String?
  phone                   String
  email                   String?
  address                 String?
  occupation              String?
  // Uploaded docs: JSON array [{ name, type, url }].
  documents               String?
  source                  String              @default("DIRECT") // DIRECT|WEBSITE|REFERRAL|ADVERTISEMENT|ENQUIRY
  status                  String              @default("PENDING")
  notes                   String?
  // Link back to the originating enquiry (named relation; Enquiry also points here).
  enquiryId               String?
  enquiry                 Enquiry?            @relation("AdmissionFromEnquiry", fields: [enquiryId], references: [id])
  convertedEnquiries      Enquiry[]           @relation("EnquiryConversion")
  // Filled on approval.
  assignedAdmissionNumber String?
  assignedClassId         String?
  assignedClass           Class?              @relation("AdmissionAssignedClass", fields: [assignedClassId], references: [id])
  assignedSectionId       String?
  assignedSection         Section?            @relation("AdmissionAssignedSection", fields: [assignedSectionId], references: [id])
  rejectionReason         String?
  processedById           String?
  processedBy             User?               @relation("AdmissionProcessor", fields: [processedById], references: [id])
  processedAt             DateTime?
  activities              AdmissionActivity[]
  schoolId                String
  school                  School              @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
  @@index([enquiryId])
}

// Interaction history for an admission application (mirrors EnquiryActivity).
model AdmissionActivity {
  id            String         @id @default(cuid())
  admissionId   String
  admission     AdmissionQuery @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  activityType  String // STATUS_CHANGE | NOTE | APPROVED | REJECTED | INFO_REQUESTED
  note          String?
  performedById String
  performedBy   User           @relation(fields: [performedById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([admissionId])
}

// A lead in the admission funnel. status pipeline:
// NEW -> CONTACTED -> VISIT_SCHEDULED -> CONVERTED | CLOSED
model Enquiry {
  id                     String            @id @default(cuid())
  parentName             String
  phone                  String
  email                  String?
  address                String?
  subject                String? // optional headline
  message                String? // notes / questions the parent asked
  // Student of interest.
  childName              String?
  childAge               String?
  childGender            String?
  currentSchool          String?
  classInterestedIn      String?
  source                 String            @default("OTHER") // WALKIN|PHONE|WEBSITE|REFERRAL|OTHER
  status                 String            @default("NEW")
  followUpDate           DateTime?
  closureReason          String? // when CLOSED
  categoryId             String?
  category               EnquiryCategory?  @relation(fields: [categoryId], references: [id])
  // Bidirectional link to the admission this converted into (named relation,
  // because AdmissionQuery also points back at Enquiry — see "AdmissionFromEnquiry").
  convertedToAdmissionId String?
  convertedToAdmission   AdmissionQuery?   @relation("EnquiryConversion", fields: [convertedToAdmissionId], references: [id])
  admissions             AdmissionQuery[]  @relation("AdmissionFromEnquiry")
  activities             EnquiryActivity[]
  schoolId               String
  school                 School            @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, followUpDate])
  @@index([categoryId])
}

// Full interaction history for an enquiry — every status change, note, call,
// follow-up. We keep this separate from the current `status` so we have an audit
// trail of HOW a lead progressed, not just where it ended up.
model EnquiryActivity {
  id            String   @id @default(cuid())
  enquiryId     String
  enquiry       Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  activityType  String // STATUS_CHANGE | NOTE | CALL | FOLLOW_UP
  fromStatus    String?
  toStatus      String?
  note          String?
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([enquiryId])
}

// Categories for enquiries, e.g. "Fees", "Transport".
model EnquiryCategory {
  id        String    @id @default(cuid())
  name      String
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id])
  enquiries Enquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// ----------------------------------------------------------------------------
// ATTENDANCE
// ----------------------------------------------------------------------------

// One row per student per day. Indexed on date for "today's attendance" queries.
model Attendance {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime
  status     String // PRESENT | ABSENT | LATE | HALF_DAY
  markedById String
  markedBy   User     @relation(fields: [markedById], references: [id])
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One attendance record per student per day — enforced and fast to look up.
  @@unique([studentId, date])
  @@index([date])
  @@index([status])
  @@index([markedById])
}

// ----------------------------------------------------------------------------
// COMMUNICATION
// ----------------------------------------------------------------------------

// A targeted announcement. The authoritative recipient list lives in
// BroadcastRecipient (one row per targeted user) — that's what powers per-user
// read tracking and the inbox. targetRole/targetLabel are for display/filtering.
model BroadcastMessage {
  id            String    @id @default(cuid())
  title         String
  message       String
  sentById      String
  sentBy        User      @relation(fields: [sentById], references: [id])
  targetRole    String    @default("ALL") // ALL | PARENTS | TEACHERS | CLASSES
  targetClassId String?
  targetClass   Class?    @relation(fields: [targetClassId], references: [id])
  targetLabel   String? // human label, e.g. "Parents of Class 5 - A"
  urgent        Boolean   @default(false)
  attachments   String? // JSON array of attachment objects
  deletedAt     DateTime? // soft delete: non-null = deleted (kept for the record)
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])

  recipients BroadcastRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([sentById])
  @@index([targetClassId])
  @@index([deletedAt])
}

// One row per (broadcast, targeted user). readAt null = unread. This separate
// table (vs. an array of reader-ids on the message) is what makes "unread count"
// and "142/200 read" efficient, indexable queries — see the walkthrough.
model BroadcastRecipient {
  id          String           @id @default(cuid())
  broadcastId String
  broadcast   BroadcastMessage @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  readAt      DateTime? // null until the user opens the message
  createdAt   DateTime         @default(now())

  // One recipient row per user per broadcast; fast unread lookups by user.
  @@unique([broadcastId, userId])
  @@index([userId, readAt])
  @@index([broadcastId])
}

// Per-user read marker for diary entries (created when a user opens an entry).
model DiaryRead {
  id            String      @id @default(cuid())
  schoolDiaryId String
  schoolDiary   SchoolDiary @relation(fields: [schoolDiaryId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  readAt        DateTime    @default(now())

  @@unique([schoolDiaryId, userId])
  @@index([userId])
}

// A feedback ticket. The conversation lives in FeedbackMessage rows (a thread),
// not in a single `reply` field — see the walkthrough on why a thread scales and
// a single reply doesn't. status is a small state machine: PENDING | REPLIED |
// CLOSED | REOPENED (transitions enforced in lib/feedback-state.ts).
model Feedback {
  id              String    @id @default(cuid())
  // referenceNumber like "FB-2026-0001", unique, generated atomically (Counter).
  referenceNumber String    @unique
  parentId        String
  // The parent link is ALWAYS stored (so the parent can track their own ticket).
  // For anonymous tickets the API/lib layer never exposes it — see the anonymity
  // walkthrough for the tradeoff this implies.
  parent          User      @relation("FeedbackParent", fields: [parentId], references: [id])
  subject         String
  message         String // original body (also the first FeedbackMessage)
  category        String? // Academic | Fees | Transport | Facilities | Staff | Other
  isAnonymous     Boolean   @default(false)
  status          String    @default("PENDING") // PENDING | REPLIED | CLOSED | REOPENED
  closingNote     String?
  lastReplyAt     DateTime? // when the principal last replied (drives parent unread)
  parentSeenAt    DateTime? // when the parent last opened it (drives parent unread)

  // legacy single-reply fields (kept nullable, unused — the thread is authoritative)
  reply       String?
  repliedById String?
  repliedBy   User?   @relation("FeedbackRepliedBy", fields: [repliedById], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  messages FeedbackMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([parentId])
  @@index([status])
  // Composite index: the principal ALWAYS filters "this school, by status" — this
  // serves it in one indexed seek (sorted by schoolId, then status).
  @@index([schoolId, status])
}

// One message in a feedback thread (from a parent or the principal). Storing the
// whole conversation as rows lets a ticket have any number of back-and-forths.
model FeedbackMessage {
  id          String   @id @default(cuid())
  feedbackId  String
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  senderRole  String // PARENT | PRINCIPAL (drives chat bubble side)
  message     String
  attachments String? // JSON array of attachment objects
  createdAt   DateTime @default(now())

  @@index([feedbackId])
  @@index([senderId])
}

// A generic atomic counter, used to mint sequential reference numbers safely
// under concurrency. One row per (school, year) sequence; see lib/feedback.ts.
model Counter {
  key       String   @id // e.g. "feedback:<schoolId>:2026"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// A dated diary note for a class (optionally a specific section).
model SchoolDiary {
  id          String   @id @default(cuid())
  title       String
  content     String
  date        DateTime
  attachments String? // JSON array of attachment objects
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  sectionId   String? // null = whole class
  section     Section? @relation(fields: [sectionId], references: [id])
  postedById  String
  postedBy    User     @relation(fields: [postedById], references: [id])
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])

  reads DiaryRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([date])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// FEES
// ----------------------------------------------------------------------------

// What a class owes for a given academic year.
model FeeStructure {
  id             String       @id @default(cuid())
  classId        String
  class          Class        @relation(fields: [classId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  // Money is stored in the SMALLEST currency unit (paise) as an integer, never a
  // float — integers are exact, so totals never drift. ₹12,000.00 is stored as
  // 1_200_000. We divide by 100 only when displaying. See lib/money.ts.
  totalAmount    Int
  description    String?
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([academicYearId])
}

// An actual payment by a student. receiptNumber unique for audit.
model FeePayment {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  amount        Int // paise (smallest unit), integer — see lib/money.ts
  date          DateTime
  mode          String // CASH | ONLINE | CHEQUE | UPI
  receiptNumber String   @unique
  notes         String?
  collectedById String
  collectedBy   User     @relation(fields: [collectedById], references: [id])
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([date])
  @@index([collectedById])
}

// ----------------------------------------------------------------------------
// ACADEMIC
// ----------------------------------------------------------------------------

// A subject offered within a class, e.g. "Mathematics" for "1st".
model Subject {
  id       String @id @default(cuid())
  name     String
  classId  String
  class    Class  @relation(fields: [classId], references: [id])
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  curriculums       Curriculum[]
  testReports       TestReport[]
  homeworks         Homework[]
  resources         Resource[]
  planners          Planner[]
  timetableEntries  TimetableEntry[]
  virtualClassrooms VirtualClassroom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
}

// Assigned homework. status: ACTIVE | ARCHIVED.
model Homework {
  id           String   @id @default(cuid())
  title        String
  description  String
  dueDate      DateTime
  // JSON array of attachment objects: [{ url, name, size, type }]. We store
  // only this metadata — the actual file bytes live in object storage.
  attachments  String?
  classId      String
  class        Class    @relation(fields: [classId], references: [id])
  sectionId    String?
  section      Section? @relation(fields: [sectionId], references: [id])
  // Subject is optional: homework must target at least a class, but tagging a
  // subject is not mandatory.
  subjectId    String?
  subject      Subject? @relation(fields: [subjectId], references: [id])
  assignedById String
  assignedBy   User     @relation(fields: [assignedById], references: [id])
  status       String   @default("ACTIVE")
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([assignedById])
  @@index([dueDate])
  @@index([status])
}

// Curriculum document for a subject.
model Curriculum {
  id          String  @id @default(cuid())
  title       String
  description String?
  fileUrl     String?
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id])
  classId     String
  class       Class   @relation(fields: [classId], references: [id])
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([subjectId])
  @@index([classId])
}

// A weekly timetable for a class/section. periods is JSON (time/subject/teacher).
model Timetable {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])
  dayOfWeek String // "MONDAY".."SUNDAY"
  periods   String // JSON: [{ time, subject, teacher }, ...]
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
}

// A single test result for a student in a subject.
model TestReport {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  // classId/sectionId are denormalized from the student so we can filter a whole
  // test (class+section+subject) without joining through Student every time.
  classId       String?
  sectionId     String?
  testName      String
  totalMarks    Float
  obtainedMarks Float
  percentage    Float? // stored (computed at entry) for fast sorting/averaging
  grade         String? // stored (computed at entry)
  remarks       String?
  date          DateTime
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per student per (subject, testName, date) → enables clean upsert.
  @@unique([studentId, subjectId, testName, date])
  @@index([schoolId])
  @@index([studentId])
  @@index([subjectId])
  @@index([date])
  // Composite index for the report-card aggregation (studentId, subjectId, date).
  @@index([studentId, subjectId, date])
  @@index([classId, sectionId])
}

// A term report card for a student. term: TERM1 | TERM2 | TERM3.
// The computed report (subject rows, attendance, rank) is FROZEN into `data` at
// generation time — a point-in-time document. status separates DRAFT (internal)
// from PUBLISHED (visible to parents). generatedAt drives staleness detection.
model ProgressReport {
  id                String       @id @default(cuid())
  studentId         String
  student           Student      @relation(fields: [studentId], references: [id])
  academicYearId    String
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id])
  term              String
  classId           String?
  sectionId         String?
  remarks           String?
  coCurricular      String?
  conduct           String? // A | B | C | D
  overallGrade      String?
  overallPercent    Float?
  attendancePercent Float?
  rank              Int?
  data              String? // JSON snapshot: subject rows + attendance for rendering
  status            String       @default("DRAFT") // DRAFT | PUBLISHED
  reportFileUrl     String?
  generatedAt       DateTime? // when the snapshot was computed (staleness baseline)
  publishedAt       DateTime?
  schoolId          String
  school            School       @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId, term])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId, term, status])
}

// ----------------------------------------------------------------------------
// E-LEARNING
// ----------------------------------------------------------------------------

// Category for tutorials & assignments.
model ELearningCategory {
  id          String       @id @default(cuid())
  name        String
  description String?
  icon        String? // an icon key (Science/Math/...)
  color       String? // a hex/color token for the card
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id])
  tutorials   Tutorial[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

// A learning resource. type: VIDEO | DOCUMENT | LINK.
model Tutorial {
  id           String             @id @default(cuid())
  title        String
  description  String?
  type         String             @default("LINK")
  videoUrl     String?
  embedUrl     String?
  linkUrl      String?
  fileUrl      String?
  categoryId   String?
  category     ELearningCategory? @relation(fields: [categoryId], references: [id])
  classId      String?
  class        Class?             @relation(fields: [classId], references: [id])
  uploadedById String
  uploadedBy   User               @relation(fields: [uploadedById], references: [id])
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([categoryId])
  @@index([classId])
  @@index([uploadedById])
}

// An e-learning assignment students submit against.
model Assignment {
  id           String             @id @default(cuid())
  title        String
  description  String?
  dueDate      DateTime
  fileUrl      String?
  attachments  String? // JSON array of reference files
  totalMarks   Int?
  status       String             @default("OPEN") // OPEN | CLOSED
  categoryId   String?
  category     ELearningCategory? @relation(fields: [categoryId], references: [id])
  classId      String?
  class        Class?             @relation(fields: [classId], references: [id])
  sectionId    String?
  section      Section?           @relation(fields: [sectionId], references: [id])
  uploadedById String
  uploadedBy   User               @relation(fields: [uploadedById], references: [id])
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id])

  submissions AssignmentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([categoryId])
  @@index([classId])
  @@index([uploadedById])
  @@index([dueDate])
  @@index([status])
}

// A student's submission. One per (assignment, student); deleting the parent
// assignment cascades its submissions.
model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  fileUrl      String?
  submittedAt  DateTime   @default(now())
  grade        String?
  feedback     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ----------------------------------------------------------------------------
// EVENTS & CALENDAR
// ----------------------------------------------------------------------------

// A calendar event. type: EXAM | SPORTS | CULTURAL | HOLIDAY | PTM | OTHER.
model Event {
  id             String    @id @default(cuid())
  title          String
  description    String?
  date           DateTime // start day (UTC midnight)
  endDate        DateTime? // optional end day for multi-day events
  type           String    @default("OTHER")
  attachments    String? // JSON array of attachment objects
  // Audience: "ALL" or "CLASSES" (with targetClassIds = JSON array of class ids).
  targetRole     String    @default("ALL")
  targetClassIds String?
  // RECURRENCE: we store ONE row + a rule and expand occurrences at read time.
  // excludedDates is a JSON array of "YYYY-MM-DD" keys removed from the series
  // (used for "delete just this occurrence"). See lib/events.ts.
  isRecurring    Boolean   @default(false)
  recurrenceFreq String? // WEEKLY | MONTHLY | YEARLY
  recurrenceEnd  DateTime?
  excludedDates  String?
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([date])
  @@index([type])
}

// A holiday entry. type: NATIONAL | FESTIVAL | BREAK | OTHER.
model Holiday {
  id          String    @id @default(cuid())
  name        String
  date        DateTime
  endDate     DateTime? // optional end day for multi-day breaks (e.g. Diwali)
  description String?
  type        String    @default("OTHER")
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([date])
}

// One meal plan per (school, day, type). The whole day's menu lives in the `menu`
// JSON: { breakfast: [...], lunch: [...], snack: [...] }. mealType is unused now
// (the JSON holds all three) — kept nullable for back-compat.
model MealCalendar {
  id       String   @id @default(cuid())
  date     DateTime
  mealType String? // legacy, unused
  menu     String // JSON: { breakfast, lunch, snack }
  type     String   @default("SCHOOL") // SCHOOL | DAYCARE
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per day per type per school → enables clean upsert by the planner.
  @@unique([schoolId, date, type])
  @@index([schoolId])
  @@index([date])
}

// ----------------------------------------------------------------------------
// MEETING ROOM (group chat)
// ----------------------------------------------------------------------------

// A chat group. Members are modeled with the MeetingGroupMember join table (M:N).
model MeetingGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  icon        String? // optional avatar URL; UI falls back to initials
  isActive    Boolean @default(true) // soft delete — hide group, keep messages
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id])

  members  MeetingGroupMember[]
  messages MeetingMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([createdById])
}

// JOIN TABLE for the User<->MeetingGroup many-to-many. The unique pair prevents
// adding the same user to a group twice.
model MeetingGroupMember {
  id         String       @id @default(cuid())
  groupId    String
  group      MeetingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  role       String       @default("MEMBER") // ADMIN | MEMBER (principal = ADMIN)
  isActive   Boolean      @default(true) // soft removal — see Phase 13 notes
  joinedAt   DateTime     @default(now())
  // UNREAD CURSOR: the moment this user last opened the chat. Unread count is
  // "messages with createdAt > lastReadAt" — an O(1) range count per group,
  // instead of a read-row per message per user. See the read-tracking note.
  lastReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, userId]) // fast membership checks
}

// A message in a group. Deleting the group cascades its messages.
model MeetingMessage {
  id          String       @id @default(cuid())
  groupId     String
  group       MeetingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User         @relation(fields: [senderId], references: [id])
  message     String
  messageType String       @default("TEXT") // TEXT | FILE | SYSTEM
  fileUrl     String?
  fileName    String?
  fileType    String?
  attachments String? // legacy JSON array of file URLs (kept for compatibility)
  isDeleted   Boolean      @default(false) // soft delete → "This message was deleted"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  // Composite index: messages are ALWAYS loaded "this group, newest first", so
  // an index on (groupId, createdAt) lets the DB seek + scan in order.
  @@index([groupId, createdAt])
}

// ----------------------------------------------------------------------------
// DAYCARE
// ----------------------------------------------------------------------------

// A daily daycare log for a student. ONE row per (student, date) — enforced by
// the unique constraint, so check-in/out is idempotent per day.
//
// WHY child tables (DaycareActivity/Meal/Nap) instead of JSON columns: activities
// and meals are QUERYABLE, structured, repeating records — "most common activity
// this week", "did they eat lunch", calendar rollups. Separate tables give each
// row real columns, indexes, and integrity. JSON would be acceptable only if the
// data were opaque blobs we never query into; here we aggregate across them.
model DaycareLog {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime // UTC-midnight day key
  checkInTime  DateTime? // stored as a UTC instant; displayed in local time
  checkOutTime DateTime?
  mood         String? // HAPPY | OKAY | UPSET | SICK
  generalNotes String?
  recordedById String
  recordedBy   User      @relation(fields: [recordedById], references: [id])
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id])

  activities DaycareActivity[]
  meals      DaycareMeal[]
  naps       DaycareNap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date]) // one log per child per day
  @@index([schoolId])
  @@index([studentId])
  @@index([date])
  @@index([recordedById])
}

model DaycareActivity {
  id           String     @id @default(cuid())
  daycareLogId String
  log          DaycareLog @relation(fields: [daycareLogId], references: [id], onDelete: Cascade)
  time         String? // "HH:MM"
  activityType String     @default("OTHER") // FREE_PLAY|ART_CRAFT|STORY_TIME|OUTDOOR|MUSIC|LEARNING|OTHER
  activityName String?
  notes        String?

  createdAt DateTime @default(now())

  @@index([daycareLogId])
}

model DaycareMeal {
  id           String     @id @default(cuid())
  daycareLogId String
  log          DaycareLog @relation(fields: [daycareLogId], references: [id], onDelete: Cascade)
  mealType     String // BREAKFAST | MORNING_SNACK | LUNCH | AFTERNOON_SNACK
  eaten        Boolean    @default(false)
  time         String? // "HH:MM"
  notes        String?

  createdAt DateTime @default(now())

  @@index([daycareLogId])
}

model DaycareNap {
  id           String     @id @default(cuid())
  daycareLogId String
  log          DaycareLog @relation(fields: [daycareLogId], references: [id], onDelete: Cascade)
  startTime    String? // "HH:MM"
  endTime      String? // "HH:MM"
  quality      String? // SLEPT_WELL | RESTLESS | DIDNT_SLEEP

  createdAt DateTime @default(now())

  @@index([daycareLogId])
}

// ----------------------------------------------------------------------------
// GALLERY
// ----------------------------------------------------------------------------

// A photo album. Images cascade-delete with the album.
model GalleryAlbum {
  id          String    @id @default(cuid())
  title       String
  description String?
  coverImage  String? // full-size URL of the chosen cover
  date        DateTime? // event date the album is about
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])

  images GalleryImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model GalleryImage {
  id       String       @id @default(cuid())
  albumId  String
  album    GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  imageUrl String // full-size (max 1920px) — used by the lightbox
  thumbUrl String? // 300px thumbnail — used by the grid (saves bandwidth)
  caption  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId])
}

// A video: either an external link (YouTube/Vimeo) or a direct upload.
model Video {
  id             String  @id @default(cuid())
  title          String
  description    String?
  source         String  @default("YOUTUBE") // YOUTUBE | VIMEO | UPLOAD
  videoUrl       String // external URL or stored file URL
  embedUrl       String? // iframe src for external videos
  thumbnailUrl   String?
  duration       String?
  category       String?
  viewCount      Int     @default(0)
  // Audience: ALL, or CLASSES with targetClassIds = JSON array of class ids.
  targetRole     String  @default("ALL")
  targetClassIds String?
  uploadedById   String
  uploadedBy     User    @relation(fields: [uploadedById], references: [id])
  schoolId       String
  school         School  @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([uploadedById])
}

// ----------------------------------------------------------------------------
// STAFF
// ----------------------------------------------------------------------------

// The HR profile for a staff User (1:1). userId is unique to enforce one-to-one.
model StaffMember {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation   String? // Principal | Teacher | Admin | Librarian | Counselor | Other
  department    String?
  employeeId    String?
  joiningDate   DateTime?
  qualification String?
  experience    String?
  photo         String?
  dateOfBirth   DateTime?
  gender        String?
  address       String?
  phone         String?
  status        String    @default("ACTIVE") // ACTIVE | ON_LEAVE | RESIGNED
  salary        Float? // principal-only
  allowances    Float? // principal-only
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// VIRTUAL CLASSROOM
// ----------------------------------------------------------------------------

// A scheduled online class. status: SCHEDULED | LIVE | COMPLETED.
model VirtualClassroom {
  id           String   @id @default(cuid())
  title        String
  description  String?
  meetingLink  String
  recordingUrl String? // added after the session
  classId      String
  class        Class    @relation(fields: [classId], references: [id])
  sectionId    String?
  section      Section? @relation(fields: [sectionId], references: [id])
  subjectId    String?
  subject      Subject? @relation(fields: [subjectId], references: [id])
  scheduledAt  DateTime
  duration     Int? // minutes
  hostId       String
  host         User     @relation(fields: [hostId], references: [id])
  // status is computed live from time, but we persist a baseline / COMPLETED flag.
  status       String   @default("SCHEDULED")
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([hostId])
  @@index([scheduledAt])
  @@index([status])
}

// ----------------------------------------------------------------------------
// TIMETABLE (relational, not JSON — enables conflict detection + teacher views)
// ----------------------------------------------------------------------------

// The school-wide period structure (bell schedule). Separated from the actual
// timetable so changing bell timings mid-year is a SINGLE edit here, leaving all
// TimetableEntry rows (which reference periodNumber) untouched.
model PeriodTemplate {
  id           String @id @default(cuid())
  periodNumber Int
  label        String
  startTime    String // "09:00"
  endTime      String // "09:45"
  type         String @default("CLASS") // CLASS | BREAK | ASSEMBLY
  schoolId     String
  school       School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, periodNumber])
  @@index([schoolId])
}

// One row per (class, section, day, period). One row per slot — so a conflict
// check is a single indexed lookup, not parsing a JSON blob.
model TimetableEntry {
  id             String       @id @default(cuid())
  classId        String
  class          Class        @relation(fields: [classId], references: [id])
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id])
  dayOfWeek      String // MON | TUE | WED | THU | FRI | SAT
  periodNumber   Int
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id])
  teacherId      String?
  teacher        User?        @relation("TeacherTimetable", fields: [teacherId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents double-booking the same slot for a class/section in a year.
  @@unique([classId, sectionId, dayOfWeek, periodNumber, academicYearId])
  // Fast conflict detection: "is this teacher already at this day+period?"
  @@index([teacherId, dayOfWeek, periodNumber])
  @@index([schoolId])
  @@index([classId, sectionId])
}

// ----------------------------------------------------------------------------
// VISITORS
// ----------------------------------------------------------------------------

// Front-desk visitor log (sign-in / sign-out).
model VisitorRegister {
  id             String    @id @default(cuid())
  name           String
  phone          String
  purpose        String    @default("OTHER") // PARENT_VISIT|VENDOR|OFFICIAL|INTERVIEW|MAINTENANCE|OTHER
  purposeOther   String? // free text when purpose = OTHER
  visitingWhomId String?
  visitingWhom   User?     @relation("VisitorHost", fields: [visitingWhomId], references: [id])
  checkInTime    DateTime  @default(now())
  checkOutTime   DateTime? // null = still on premises
  idProofType    String? // AADHAAR|DRIVING_LICENSE|VOTER_ID|PASSPORT|OTHER
  idNumber       String?
  notes          String?
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, checkInTime]) // fast "today's visitors" queries
  @@index([phone]) // repeat-visitor detection
}

// ----------------------------------------------------------------------------
// PLANNERS & RESOURCES
// ----------------------------------------------------------------------------

// A teacher planner. type: LESSON_PLAN | ACTIVITY | WEEKLY_PLAN | MONTHLY_PLAN | OTHER.
// The plan can live INLINE (in `description`, edited in-app) and/or as an
// attached `fileUrl`. Inline is preferred for plans teachers revise often.
model Planner {
  id          String   @id @default(cuid())
  title       String
  description String? // inline plan content (rich text/markdown)
  type        String   @default("OTHER")
  fileUrl     String?
  fileName    String?
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
  @@index([createdById])
  @@index([type])
}

// A shared resource. type: DOCUMENT | VIDEO | LINK | WORKSHEET | PRESENTATION.
model Resource {
  id            String   @id @default(cuid())
  title         String
  description   String?
  fileUrl       String? // uploaded file
  externalUrl   String? // OR an external link (type LINK/VIDEO)
  fileName      String?
  fileSize      Int? // bytes
  fileType      String? // mime type
  type          String   @default("DOCUMENT")
  downloadCount Int      @default(0) // bumped atomically on each download
  isPublic      Boolean  @default(false) // shared with parents?
  subjectId     String?
  subject       Subject? @relation(fields: [subjectId], references: [id])
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([subjectId])
  @@index([uploadedById])
  @@index([type])
  @@index([isPublic])
}

// ----------------------------------------------------------------------------
// SETTINGS — notification prefs, bug reports, support messages (Phase 15)
// ----------------------------------------------------------------------------

// Per-user, per-category notification toggle. Absence of a row = default ON, so
// we only store explicit opt-outs/opt-ins. Checked at SEND time before queuing a
// notification (see lib/notify.ts) so we never even create unwanted ones.
model NotificationPreference {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     String // BROADCAST | HOMEWORK | FEES | ATTENDANCE | EVENTS | DIARY
  enabled  Boolean @default(true)
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

// A bug report from the support section, with auto-collected device info.
model BugReport {
  id           String  @id @default(cuid())
  description  String
  deviceInfo   String? // JSON: { userAgent, platform, screen, language }
  screenshot   String? // optional uploaded image URL
  reportedById String
  reportedBy   User    @relation(fields: [reportedById], references: [id])
  status       String  @default("OPEN") // OPEN | RESOLVED
  schoolId     String
  school       School  @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  @@index([schoolId])
}

// A technical-support contact message.
model SupportMessage {
  id       String @id @default(cuid())
  subject  String
  message  String
  sentById String
  sentBy   User   @relation(fields: [sentById], references: [id])
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  @@index([schoolId])
}

// ----------------------------------------------------------------------------
// PHASE 16 — activity log, in-app notifications, push subscriptions
// ----------------------------------------------------------------------------

// An audit/activity log: an append-only record of important actions across the
// app. Powers the dashboard activity feed AND gives accountability/security — you
// can answer "who marked attendance for 5A, and when?" after the fact.
model ActivityLog {
  id            String   @id @default(cuid())
  action        String // e.g. ATTENDANCE_MARKED | ENQUIRY_CREATED | FEE_RECORDED
  description   String // human-readable: "Marked attendance for Class 5A"
  entityType    String? // e.g. "Attendance" | "Enquiry"
  entityId      String?
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  createdAt     DateTime @default(now())

  @@index([schoolId, createdAt])
}

// An in-app notification record (separate from the push delivery). Shown in the
// bell dropdown; when a push is sent we also create one of these.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String? // deep link opened on click
  type      String   @default("GENERAL")
  isRead    Boolean  @default(false)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// A Web Push subscription. One user may have several (phone + laptop). endpoint
// is unique per browser+device; p256dh/auth are the encryption keys the push
// service needs to deliver our encrypted payload.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// ONLINE PAYMENTS (Razorpay)
// ----------------------------------------------------------------------------

// Tracks EVERY online payment attempt — including failed/abandoned ones — so we
// have an audit trail beyond the successful FeePayment rows. status moves
// CREATED -> PAID | FAILED. The razorpay* fields are what we verify the
// HMAC-SHA256 signature against before trusting a payment.
model PaymentTransaction {
  id                String   @id @default(cuid())
  amount            Int // paise
  status            String   @default("CREATED") // CREATED | PAID | FAILED
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  razorpaySignature String?
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId          String
  parent            User     @relation(fields: [parentId], references: [id])
  schoolId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studentId])
  @@index([parentId])
  @@index([status])
}
