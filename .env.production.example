# ===========================================================================
# PRODUCTION environment variables — set these in the Vercel dashboard, NOT in
# git. This file is a checklist/template (safe to commit because it has no real
# secrets). Copy the keys, fill real values in Vercel → Settings → Environment
# Variables. A leaked secret here = anyone can forge sessions or read your DB.
# ===========================================================================

# Hosted Postgres connection string (Supabase or Neon). Use the POOLED connection
# string for serverless (Vercel) — direct connections exhaust the DB's pool.
# Supabase: Project → Settings → Database → Connection string → "Transaction" pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Some Prisma setups also want a direct (non-pooled) URL for migrations:
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Long random string signing the session JWT. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_openssl_rand_base64_32"

# The canonical production URL (your domain). Must match where the app is served.
NEXTAUTH_URL="https://your-school.example.com"

# Web Push (VAPID). Generate a FRESH pair for production:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY="REPLACE"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="REPLACE_SAME_AS_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="REPLACE_KEEP_SECRET"
VAPID_SUBJECT="mailto:office@your-school.example.com"

# Supabase (only if you use its storage/auth helpers; the app itself talks to
# Postgres via DATABASE_URL above).
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="REPLACE"
SUPABASE_SERVICE_KEY="REPLACE_KEEP_SECRET"

# Razorpay — use LIVE keys (rzp_live_…) in production. KEY_SECRET signs/verifies
# payments server-side; never expose it. KEY_ID is also public for Checkout.
RAZORPAY_KEY_ID="rzp_live_REPLACE"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_REPLACE"
RAZORPAY_KEY_SECRET="REPLACE_KEEP_SECRET"
